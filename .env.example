# Template for your local .env file. Copy it to .env and replace every
# CHANGE_ME with a long random value. .env is never committed (see .gitignore).
#
# Real environment variables override anything written in .env.

ENVIRONMENT=local

# Passwords the Postgres and Redis containers are created with (S0.7).
# They must match the passwords inside the two URLs below.
POSTGRES_PASSWORD=CHANGE_ME
REDIS_PASSWORD=CHANGE_ME

# Use 127.0.0.1, not "localhost". On Windows, localhost tries IPv6 (::1)
# first; Docker only listens on 127.0.0.1, and the fallback takes ~2s, which
# makes the 2s readiness check time out (found in S0.8).

# Postgres connection: driver://user:password@host:port/database
DATABASE_URL=postgresql+asyncpg://seatsurge:CHANGE_ME@127.0.0.1:5432/seatsurge

# Redis connection: redis://:password@host:port/db-number
REDIS_URL=redis://:CHANGE_ME@127.0.0.1:6379/0

# Signs login tokens (S1.4). Must be at least 32 random characters, e.g. from:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Changing it logs everyone out (all existing tokens stop verifying).
JWT_SECRET_KEY=CHANGE_ME

# Mock payments (there are no real payments): the chance a valid tok_ok charge
# is randomly declined, to exercise failure paths. 0.0 = never, 1.0 = always.
PAYMENT_FAILURE_RATE=0.0
